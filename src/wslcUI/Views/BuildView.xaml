<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="wslcUI.Views.BuildView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:wslcUI.Models"
    xmlns:conv="using:wslcUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 构建页。可见性由自身绑定决定，MainWindow 只负责摆放。 -->
    <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsBuildPage), Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="构建" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Column="1" PlaceholderText="构建上下文目录 (含 Dockerfile)" VerticalAlignment="Center"
                     Text="{x:Bind ViewModel.BuildContext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="浏览" Command="{x:Bind ViewModel.PickBuildContextCommand}" />
            <TextBox Grid.Column="3" PlaceholderText="标签 (如 myimage:latest)" VerticalAlignment="Center"
                     Text="{x:Bind ViewModel.BuildTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="5" Content="开始构建" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.BuildImageCommand}"
                    IsEnabled="{x:Bind ViewModel.CanBuild, Mode=OneWay}" />
        </Grid>

        <Border Grid.Row="1" Margin="12,8" CornerRadius="6"
                Background="{ThemeResource LogPaneBg}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer Padding="12">
                <TextBlock Text="{x:Bind ViewModel.BuildOutput, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>
        <TextBlock Grid.Row="1" Text="构建日志将显示在此。填写上下文目录与标签后点击「开始构建」。"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasBuildOutput), Mode=OneWay}" />
    </Grid>
</UserControl>
