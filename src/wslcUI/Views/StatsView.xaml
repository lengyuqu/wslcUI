<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="wslcUI.Views.StatsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:wslcUI.Models"
    xmlns:conv="using:wslcUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 统计页。可见性由自身绑定决定，MainWindow 只负责摆放。 -->
    <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsStatsPage), Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="统计" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Column="1" PlaceholderText="搜索容器…" VerticalAlignment="Center"
                     Text="{x:Bind ViewModel.StatsPage.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2" Text="快照是一次性读数；「开始采样」每 3 秒轮询一次并画曲线。"
                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Button Grid.Column="3" Content="刷新快照" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.RefreshSnapshotCommand}" />
            <Button Grid.Column="4" Content="开始采样"
                    Command="{x:Bind ViewModel.Sampling.ToggleSamplingCommand}"
                    Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.Sampling.IsSampling), Mode=OneWay}" />
            <Button Grid.Column="4" Content="停止采样"
                    Command="{x:Bind ViewModel.Sampling.ToggleSamplingCommand}"
                    Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.Sampling.IsSampling), Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="运行中容器" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.RunningCountText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="已停止 / 异常" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StoppedCountText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="快照容器数" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.StatsCountText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="镜像 / 网络 / 卷" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ResourceSummaryText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="8,6" Margin="12,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="容器" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.SortByCommand}" CommandParameter="Container" />
            <Button Grid.Column="1" Content="CPU%" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.SortByCommand}" CommandParameter="Cpu" />
            <Button Grid.Column="2" Content="内存 / 限制" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.SortByCommand}" CommandParameter="Mem" />
            <Button Grid.Column="3" Content="内存%" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.SortByCommand}" CommandParameter="MemPercent" />
            <Button Grid.Column="4" Content="网络 I/O" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.SortByCommand}" CommandParameter="NetIo" />
            <Button Grid.Column="5" Content="块 I/O" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.SortByCommand}" CommandParameter="BlockIo" />
            <Button Grid.Column="6" Content="PID" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.SortByCommand}" CommandParameter="Pids" />
        </Grid>

        <ListView Grid.Row="3" Margin="12,0"
                  ItemsSource="{x:Bind ViewModel.StatsPage.Items, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.StatsPage.SelectedItem, Mode=TwoWay}"
                  SelectionMode="Single" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:StatInfo">
                    <Grid Padding="8,6" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Container}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Cpu}" FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Mem}" FontSize="12" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{x:Bind MemPercent}" FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind NetIo}" FontSize="12" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="5" Text="{x:Bind BlockIo}" FontSize="12" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="6" Text="{x:Bind Pids}" FontSize="12" FontFamily="Consolas"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="3" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.StatsPage.HasItems), Mode=OneWay}">
            <TextBlock Text="暂无资源统计" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="点击「刷新快照」采集一次当前用量。wslc 仅统计运行中的容器。"
                       FontSize="12.5" MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="0,6,0,12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Button Content="刷新快照" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.StatsPage.RefreshSnapshotCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
