<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="wslcUI.Views.MaintenanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:wslcUI.Models"
    xmlns:conv="using:wslcUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 维护页。可见性由自身绑定决定，MainWindow 只负责摆放。 -->
    <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsMaintenancePage), Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="维护" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1"
                       Text="占用合计只覆盖镜像 —— wslc 不提供容器/卷的磁盘占用（volume list 的 Size 恒为 N/A）。"
                       FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Button Grid.Column="2" Content="刷新" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="镜像总占用" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Maintenance.ImageTotalSizeText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="镜像数量" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Maintenance.ImageCountText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="可清理容器" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Maintenance.ReclaimableContainersText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                <StackPanel>
                    <TextBlock Text="网络 / 卷" FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Maintenance.NetworkVolumeCountText, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Padding="12,0,12,8" Spacing="6">
            <TextBlock Text="一键清理" FontSize="13" FontWeight="SemiBold" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                           Text="已停止的容器　可写层数据会丢失，镜像与卷不受影响" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" MinWidth="28"
                           HorizontalAlignment="Right" Margin="0,0,10,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.Maintenance.ReclaimableContainersText, Mode=OneWay}" />
                <Button Grid.Column="2" Content="清理容器" MinWidth="96"
                        Command="{x:Bind ViewModel.Maintenance.PruneContainersCommand}"
                        IsEnabled="{x:Bind ViewModel.Maintenance.CanPrune, Mode=OneWay}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                           Text="悬空镜像　无标签且无容器引用的中间层" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" MinWidth="28"
                           HorizontalAlignment="Right" Margin="0,0,10,0"
                           Text="" />
                <Button Grid.Column="2" Content="清理悬空" MinWidth="96"
                        Command="{x:Bind ViewModel.Maintenance.PruneDanglingImagesCommand}"
                        IsEnabled="{x:Bind ViewModel.Maintenance.CanPrune, Mode=OneWay}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                           Text="未使用的镜像　⚠ 连带标签的一起删，需重新 pull / build" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" MinWidth="28"
                           HorizontalAlignment="Right" Margin="0,0,10,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.Maintenance.ImageCountText, Mode=OneWay}" />
                <Button Grid.Column="2" Content="清理全部镜像" MinWidth="96"
                        Command="{x:Bind ViewModel.Maintenance.PruneUnusedImagesCommand}"
                        IsEnabled="{x:Bind ViewModel.Maintenance.CanPrune, Mode=OneWay}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                           Text="未使用的网络　内置 bridge / host / none 不会被删" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" MinWidth="28"
                           HorizontalAlignment="Right" Margin="0,0,10,0"
                           Text="" />
                <Button Grid.Column="2" Content="清理网络" MinWidth="96"
                        Command="{x:Bind ViewModel.Maintenance.PruneNetworksCommand}"
                        IsEnabled="{x:Bind ViewModel.Maintenance.CanPrune, Mode=OneWay}" />
            </Grid>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                           Text="未使用的卷　⚠ 卷内数据会一并销毁，已停止的数据库也中招" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" MinWidth="28"
                           HorizontalAlignment="Right" Margin="0,0,10,0"
                           Text="" />
                <Button Grid.Column="2" Content="清理卷" MinWidth="96"
                        Command="{x:Bind ViewModel.Maintenance.PruneVolumesCommand}"
                        IsEnabled="{x:Bind ViewModel.Maintenance.CanPrune, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <Grid Grid.Row="3" Margin="12,0,12,12">
            <Border CornerRadius="6"
                    Background="{ThemeResource LogPaneBg}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ScrollViewer Padding="12">
                    <TextBlock Text="{x:Bind ViewModel.Maintenance.CleanupOutput, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
            <TextBlock Text="清理结果会显示在此（CLI 原始输出，不解析）。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.Maintenance.HasCleanupOutput), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
