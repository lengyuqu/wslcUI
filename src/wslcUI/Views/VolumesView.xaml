<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="wslcUI.Views.VolumesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:wslcUI.Models"
    xmlns:conv="using:wslcUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 卷页。可见性由自身绑定决定，MainWindow 只负责摆放。 -->
    <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsVolumesPage), Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="卷" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Column="1" PlaceholderText="搜索卷…" VerticalAlignment="Center"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="2" PlaceholderText="新卷名称" VerticalAlignment="Center"
                     Text="{x:Bind ViewModel.NewVolumeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="3" Content="新建卷" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.CreateVolumeCommand}"
                    IsEnabled="{x:Bind ViewModel.CanCreateVolume, Mode=OneWay}" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="排序 " /><Run Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                </TextBlock>
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="8,6" Margin="12,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="名称" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Name" />
            <Button Grid.Column="1" Content="驱动" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Driver" />
            <Button Grid.Column="2" Content="挂载点" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Mountpoint" />
        </Grid>

        <ListView Grid.Row="2" Margin="12,0"
                  ItemsSource="{x:Bind ViewModel.FilteredVolumes, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedVolume, Mode=TwoWay}"
                  SelectionMode="Single" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:VolumeInfo">
                    <Grid Padding="8,6" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Driver}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Mountpoint}" FontSize="12" FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasVolumes), Mode=OneWay}">
            <StackPanel Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                <TextBlock Text="暂无数据卷" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="卷用于持久化容器数据，删除容器后依然保留。" FontSize="12.5"
                           MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                <TextBlock Text="没有匹配的卷" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="清除搜索" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Command="{x:Bind ViewModel.ClearSearchCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
