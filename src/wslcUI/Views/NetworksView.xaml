<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="wslcUI.Views.NetworksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:wslcUI.Models"
    xmlns:conv="using:wslcUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 网络页。可见性由自身绑定决定，MainWindow 只负责摆放。 -->
    <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsNetworksPage), Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="网络" FontSize="15" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox Grid.Column="1" PlaceholderText="搜索网络…" VerticalAlignment="Center"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Column="2" PlaceholderText="新网络名称" VerticalAlignment="Center"
                     Text="{x:Bind ViewModel.NewNetworkName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="3" Content="新建网络" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.CreateNetworkCommand}"
                    IsEnabled="{x:Bind ViewModel.CanCreateNetwork, Mode=OneWay}" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="排序 " /><Run Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                </TextBlock>
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="8,6" Margin="12,0"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="名称" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Name" />
            <Button Grid.Column="1" Content="驱动" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Driver" />
            <Button Grid.Column="2" Content="作用域" Style="{StaticResource HeaderButtonStyle}"
                    Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Scope" />
        </Grid>

        <ListView Grid.Row="4" Margin="12,0"
                  ItemsSource="{x:Bind ViewModel.FilteredNetworks, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedNetwork, Mode=TwoWay}"
                  SelectionMode="Single" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:NetworkInfo">
                    <Grid Padding="8,6" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Driver}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Scope}" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasNetworks), Mode=OneWay}">
            <StackPanel Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                <TextBlock Text="暂无网络" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="创建一个网络，让多个容器通过名称互相访问。" FontSize="12.5"
                           MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                <TextBlock Text="没有匹配的网络" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="清除搜索" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Command="{x:Bind ViewModel.ClearSearchCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
