<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RootNamespace>wslcUI</RootNamespace>
    <AssemblyName>wslcUI</AssemblyName>

    <!-- 版本号。发版时与 git tag 对齐：tag vX.Y.Z ↔ <Version>X.Y.Z</Version>。
         不设此属性时 SDK 会给 1.0.0.0 —— 代码升级了但程序集版本不动，
         二进制之间没有任何版本差异（v1.0.0 之后攒了 14 个 commit 才补上）。
         FileVersion / ProductVersion / InformationalVersion 由 SDK 从 Version 推导，
         ProductVersion 还会自动追加 SourceRevisionId（commit hash）便于溯源。 -->
    <Version>1.2.0</Version>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultProgramFile>false</EnableDefaultProgramFile>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged WinUI 3:
         - set to true to build self-contained (no runtime install needed), or
         - leave false and install the Windows App SDK 2.4 runtime on dev machines. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Bootstrap is done manually in Program.cs (so the HRESULT is surfaced);
         disable the package's auto-initializer to avoid double init. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- wslc container SDK (GA as of 3.0.1). Pinned to 3.0.3 — nuget.org 上
         3.0.x 系列的最新投影，对应本机 wslc 3.0.4.0 CLI
         （nuget.org 发布序列 2.9.3 / 2.9.9 / 3.0.1 / 3.0.3；SDK 包总是略滞后于
         runtime 补丁号，3.0.x 内 COM/WinRT 向后兼容）。
         winmd diff vs 3.0.1 见 docs/ARCHITECTURE.md「SDK 版本」段落。 -->
    <PackageReference Include="Microsoft.WSL.Containers" Version="3.0.3" />
    <!-- R3：终端核心（VT/ANSI 解析 + 屏幕 cell buffer + 输入序列生成）。
         选型见 docs/TERMINAL-RENDER-DECISION.md（双盲 spike：4/4 真实 VT 流夹具
         零修改渲染正确，CJK 双宽自带；MIT、headless、无 UI 依赖）。 -->
    <PackageReference Include="XTerm.NET" Version="1.1.2" />
    <!-- XTerm.NET 的传递依赖，这里显式引用：渲染层用 wcwidth 判定
         CJK 等双宽字符，跳过其在 cell 缓冲中的续格（见 TerminalView.RenderRow）。 -->
    <PackageReference Include="Wcwidth" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真机验证项目 tools/wslcUI.Verify 直接调用 internal 的 WslcCli / PseudoConsole，
         走真实代码路径（而非逻辑副本）验证缺陷修复；单元测试项目同理测 TranslateCliError。 -->
    <InternalsVisibleTo Include="wslcUI.Verify" />
    <InternalsVisibleTo Include="wslcUI.Tests" />
  </ItemGroup>

</Project>
