<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
    <RootNamespace>wslcUI</RootNamespace>
    <AssemblyName>wslcUI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <EnableDefaultProgramFile>false</EnableDefaultProgramFile>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Unpackaged WinUI 3:
         - set to true to build self-contained (no runtime install needed), or
         - leave false and install the Windows App SDK 2.4 runtime on dev machines. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Bootstrap is done manually in Program.cs (so the HRESULT is surfaced);
         disable the package's auto-initializer to avoid double init. -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- wslc container SDK (preview). Pinned to 2.9.9 to match wslc 2.9.9.0
         (nuget.org publishes 2.9.3 and 2.9.9; 2.9.9 is the generation
         matching the current wslc CLI). -->
    <PackageReference Include="Microsoft.WSL.Containers" Version="2.9.9" />
    <!-- R3：终端核心（VT/ANSI 解析 + 屏幕 cell buffer + 输入序列生成）。
         选型见 docs/TERMINAL-RENDER-DECISION.md（双盲 spike：4/4 真实 VT 流夹具
         零修改渲染正确，CJK 双宽自带；MIT、headless、无 UI 依赖）。 -->
    <PackageReference Include="XTerm.NET" Version="1.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- 真机验证项目 tools/wslcUI.Verify 直接调用 internal 的 WslcCli / PseudoConsole，
         走真实代码路径（而非逻辑副本）验证缺陷修复；单元测试项目同理测 TranslateCliError。 -->
    <InternalsVisibleTo Include="wslcUI.Verify" />
    <InternalsVisibleTo Include="wslcUI.Tests" />
  </ItemGroup>

</Project>
