<Window
    x:Class="wslcUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wslcUI"
    xmlns:models="using:wslcUI.Models"
    xmlns:conv="using:wslcUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="wslcUI — WSL 容器管理">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Global toolbar -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                             Width="20" Height="20" />
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=OneWay}"
                     Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}"
                     Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                     Title="提示"
                     CornerRadius="4">
                <InfoBar.ActionButton>
                    <Button Content="关闭" Command="{x:Bind ViewModel.DismissInfoCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- Body: Pivot over the four resource types -->
        <Pivot Grid.Row="1" x:Name="ResourcePivot">
            <!-- 容器 -->
            <PivotItem Header="容器">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="启动" Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                        <Button Content="停止" Command="{x:Bind ViewModel.StopCommand}" IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                        <Button Content="删除" Command="{x:Bind ViewModel.DeleteContainerCommand}" IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                        <Button Content="日志" Command="{x:Bind ViewModel.ShowLogsCommand}" IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                        <Button Content="终端" x:Name="OpenTerminalButton" Click="OpenTerminalButton_Click" IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                              BorderThickness="1">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="名称" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="镜像" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="状态" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ContainerInfo">
                                <Grid Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Image}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1"
                               Text="暂无容器。点击「刷新」加载；或先在「镜像」页拉取镜像后运行。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasContainers), Mode=OneWay}" />
                </Grid>
            </PivotItem>

            <!-- 镜像 -->
            <PivotItem Header="镜像">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBox Width="240" VerticalAlignment="Center"
                                 PlaceholderText="镜像引用 (如 alpine:latest)"
                                 Text="{x:Bind ViewModel.PullReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="拉取" Command="{x:Bind ViewModel.PullCommand}" IsEnabled="{x:Bind ViewModel.CanPull, Mode=OneWay}" />
                        <Button Content="删除镜像" Command="{x:Bind ViewModel.DeleteImageCommand}" IsEnabled="{x:Bind ViewModel.CanActOnImage, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
                              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                              BorderThickness="1">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="仓库" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="标签" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="大小" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ImageInfo">
                                <Grid Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Repository}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Tag}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Size}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1"
                               Text="暂无镜像。在上方输入框填入引用（如 alpine:latest）后点击「拉取」。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasImages), Mode=OneWay}" />
                </Grid>
            </PivotItem>

            <!-- 网络 -->
            <PivotItem Header="网络">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBox Width="220" VerticalAlignment="Center"
                                 PlaceholderText="新网络名称"
                                 Text="{x:Bind ViewModel.NewNetworkName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="创建" Command="{x:Bind ViewModel.CreateNetworkCommand}" IsEnabled="{x:Bind ViewModel.CanCreateNetwork, Mode=OneWay}" />
                        <Button Content="删除" Command="{x:Bind ViewModel.RemoveNetworkCommand}" IsEnabled="{x:Bind ViewModel.CanActOnNetwork, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Networks, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedNetwork, Mode=TwoWay}"
                              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                              BorderThickness="1">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="名称" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="驱动" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="作用域" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:NetworkInfo">
                                <Grid Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Driver}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Scope}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1"
                               Text="暂无网络。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasNetworks), Mode=OneWay}" />
                </Grid>
            </PivotItem>

            <!-- 卷 -->
            <PivotItem Header="卷">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBox Width="220" VerticalAlignment="Center"
                                 PlaceholderText="新卷名称"
                                 Text="{x:Bind ViewModel.NewVolumeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="创建" Command="{x:Bind ViewModel.CreateVolumeCommand}" IsEnabled="{x:Bind ViewModel.CanCreateVolume, Mode=OneWay}" />
                        <Button Content="删除" Command="{x:Bind ViewModel.RemoveVolumeCommand}" IsEnabled="{x:Bind ViewModel.CanActOnVolume, Mode=OneWay}" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Volumes, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedVolume, Mode=TwoWay}"
                              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                              BorderThickness="1">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="名称" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="驱动" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VolumeInfo">
                                <Grid Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Driver}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1"
                               Text="暂无卷。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasVolumes), Mode=OneWay}" />
                </Grid>
            </PivotItem>

            <!-- 统计 -->
            <PivotItem Header="统计">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="刷新统计" Command="{x:Bind ViewModel.RefreshStatsCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Stats, Mode=OneWay}"
                              BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                              BorderThickness="1">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="容器" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="CPU%" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="内存/限制" />
                                    <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="内存%" />
                                    <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="网络 I/O" />
                                    <TextBlock Grid.Column="5" FontWeight="SemiBold" Text="块 I/O" />
                                    <TextBlock Grid.Column="6" FontWeight="SemiBold" Text="PID" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:StatInfo">
                                <Grid Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Container}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Cpu}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Mem}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind MemPercent}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind NetIo}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind BlockIo}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Pids}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1"
                               Text="暂无资源统计。点击「刷新统计」采集一次快照。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasStats), Mode=OneWay}" />
                </Grid>
            </PivotItem>

            <!-- 构建 -->
            <PivotItem Header="构建">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBox Width="320" VerticalAlignment="Center"
                                 PlaceholderText="构建上下文目录 (含 Dockerfile)"
                                 Text="{x:Bind ViewModel.BuildContext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="浏览" Command="{x:Bind ViewModel.PickBuildContextCommand}" />
                        <TextBox Width="200" VerticalAlignment="Center"
                                 PlaceholderText="标签 (如 myimg:latest)"
                                 Text="{x:Bind ViewModel.BuildTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="构建" Command="{x:Bind ViewModel.BuildImageCommand}" IsEnabled="{x:Bind ViewModel.CanBuild, Mode=OneWay}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                                  BorderThickness="1">
                        <TextBlock Text="{x:Bind ViewModel.BuildOutput, Mode=OneWay}"
                                   TextWrapping="Wrap" FontFamily="Consolas" Padding="8" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1"
                               Text="构建日志将显示在此。填写上下文目录与标签后点击「构建」。"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasBuildOutput), Mode=OneWay}" />
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Logs panel (always present; populated by the 日志 button) -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="日志" Margin="0,0,0,4" />
            <ScrollViewer Grid.Row="1"
                          BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                          BorderThickness="1">
                <TextBlock Text="{x:Bind ViewModel.Logs, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas" Padding="8" />
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Margin="0,8,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="wslc 2.9.4 · Microsoft.WSL.Containers SDK (preview) + wslc CLI bridge for containers/networks/volumes" />
    </Grid>
</Window>
