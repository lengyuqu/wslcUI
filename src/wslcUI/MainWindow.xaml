<Window
    x:Class="wslcUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wslcUI"
    xmlns:models="using:wslcUI.Models"
    xmlns:conv="using:wslcUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="wslcUI — WSL 容器管理">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Grid Grid.Row="0" Padding="14,0" ColumnSpacing="12"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="wslcUI" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="WSL 容器管理" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                <Button Content="主题" Command="{x:Bind ViewModel.ToggleThemeCommand}"
                        ToolTipService.ToolTip="切换深色 / 亮色主题" Padding="10,4" />
                <Button Content="详情" Command="{x:Bind ViewModel.ToggleDetailCommand}"
                        ToolTipService.ToolTip="显示 / 隐藏右侧详情面板" Padding="10,4" />
            </StackPanel>
        </Grid>

        <!-- ============ 错误 / 提示（InfoBar） ============ -->
        <InfoBar Grid.Row="1" Margin="12,8,12,0" Title="提示" CornerRadius="6"
                 IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.InfoSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="关闭" Command="{x:Bind ViewModel.DismissInfoCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ============ 忙碌指示：非阻塞，导航仍可用 ============ -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Margin="12,6,12,0"
                     Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsBusy), Mode=OneWay}" />

        <!-- ============ 主体：导航 + 内容 | 详情面板 ============ -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <NavigationView x:Name="NavView" Grid.Column="0"
                            PaneDisplayMode="Left" OpenPaneLength="220" IsPaneToggleButtonVisible="True"
                            IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                            SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem IsSelected="True" Content="容器" Tag="Containers">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="镜像" Tag="Images">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="网络" Tag="Networks">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="卷" Tag="Volumes">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Save" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem Content="统计" Tag="Stats">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="FourBars" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="构建" Tag="Build">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.Content>
                    <Grid>

                        <!-- 容器页 -->
                        <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsContainersPage), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="容器" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" PlaceholderText="搜索名称 / 镜像 / 端口…" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="启动" Command="{x:Bind ViewModel.StartCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                    <Button Content="停止" Command="{x:Bind ViewModel.StopCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                    <Button Content="日志" Command="{x:Bind ViewModel.ShowLogsCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                    <Button Content="终端" Click="OpenTerminal_Click"
                                            IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="排序 " /><Run Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}">
                                        <Button.KeyboardAccelerators>
                                            <KeyboardAccelerator Key="F5" />
                                        </Button.KeyboardAccelerators>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Padding="8,6" Margin="12,0"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="名称" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Name" />
                                <Button Grid.Column="1" Content="镜像" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Image" />
                                <Button Grid.Column="2" Content="状态" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Status" />
                                <Button Grid.Column="3" Content="端口" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Ports" />
                                <Button Grid.Column="4" Content="CPU" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Cpu" />
                                <Button Grid.Column="5" Content="创建" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="CreatedAt" />
                            </Grid>

                            <ListView Grid.Row="2" Margin="12,0"
                                      ItemsSource="{x:Bind ViewModel.FilteredContainers, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                      SelectionMode="Single" Padding="0"
                                      DoubleTapped="ContainersList_DoubleTapped">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ContainerInfo">
                                        <Grid Padding="8,6" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="1.2*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="104" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Image, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                            <Border Grid.Column="2" CornerRadius="9" Padding="8,2" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{ThemeResource StatusRunningBg}" BorderBrush="{ThemeResource StatusRunningBd}"
                                                    Visibility="{x:Bind IsRunning, Mode=OneWay}">
                                                <TextBlock Text="运行中" FontSize="11.5" Foreground="{ThemeResource StatusRunningFg}" />
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="9" Padding="8,2" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{ThemeResource StatusStoppedBg}" BorderBrush="{ThemeResource StatusStoppedBd}"
                                                    Visibility="{x:Bind IsStopped, Mode=OneWay}">
                                                <TextBlock Text="已停止" FontSize="11.5" Foreground="{ThemeResource StatusStoppedFg}" />
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="9" Padding="8,2" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{ThemeResource StatusErrorBg}" BorderBrush="{ThemeResource StatusErrorBd}"
                                                    Visibility="{x:Bind IsError, Mode=OneWay}">
                                                <TextBlock Text="异常退出" FontSize="11.5" Foreground="{ThemeResource StatusErrorFg}" />
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="9" Padding="8,2" BorderThickness="1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{ThemeResource StatusStoppedBg}" BorderBrush="{ThemeResource StatusStoppedBd}"
                                                    Visibility="{x:Bind IsUnknownStatus, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind StatusLabel, Mode=OneWay}" FontSize="11.5"
                                                           Foreground="{ThemeResource StatusStoppedFg}" />
                                            </Border>

                                            <TextBlock Grid.Column="3" Text="{x:Bind Ports, Mode=OneWay}" FontSize="12" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Cpu, Mode=OneWay}" FontSize="12" FontFamily="Consolas" MinWidth="38" />
                                                <ProgressBar Width="52" Height="4" MinWidth="0" Maximum="100"
                                                             Value="{x:Bind CpuValue, Mode=OneWay}"
                                                             Visibility="{x:Bind HasStats, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="5" Text="{x:Bind CreatedAt, Mode=OneWay}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasContainers), Mode=OneWay}">
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="还没有容器" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="先到「镜像」页拉取一个镜像，或从命令行创建容器后刷新。"
                                               FontSize="12.5" MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center"
                                               Margin="0,6,0,12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button Content="去拉取镜像" HorizontalAlignment="Center"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.NavigateCommand}" CommandParameter="Images" />
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="没有匹配的容器" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="换个关键词，或清除搜索查看全部。" FontSize="12.5" TextAlignment="Center"
                                               Margin="0,6,0,12"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <Button Content="清除搜索" HorizontalAlignment="Center"
                                            Command="{x:Bind ViewModel.ClearSearchCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 镜像页 -->
                        <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsImagesPage), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="镜像" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" PlaceholderText="搜索仓库 / 标签…" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" PlaceholderText="镜像引用 (如 alpine:latest)" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.PullReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3" Content="拉取" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.PullCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanPull, Mode=OneWay}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="排序 " /><Run Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Padding="8,6" Margin="12,0"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="仓库" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Repository" />
                                <Button Grid.Column="1" Content="标签" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Tag" />
                                <Button Grid.Column="2" Content="大小" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Size" />
                                <TextBlock Grid.Column="3" Text="摘要" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>

                            <ListView Grid.Row="2" Margin="12,0"
                                      ItemsSource="{x:Bind ViewModel.FilteredImages, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
                                      SelectionMode="Single" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ImageInfo">
                                        <Grid Padding="8,6" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Repository}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Tag}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Size}" FontSize="12" FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind DigestDisplay}" FontSize="12" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasImages), Mode=OneWay}">
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="本地还没有镜像" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="在上方输入镜像引用后点击「拉取」，例如 alpine:latest。" FontSize="12.5"
                                               MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="没有匹配的镜像" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="清除搜索" HorizontalAlignment="Center" Margin="0,12,0,0"
                                            Command="{x:Bind ViewModel.ClearSearchCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 网络页 -->
                        <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsNetworksPage), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="网络" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" PlaceholderText="搜索网络…" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" PlaceholderText="新网络名称" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.NewNetworkName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3" Content="新建网络" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.CreateNetworkCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanCreateNetwork, Mode=OneWay}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="排序 " /><Run Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Padding="8,6" Margin="12,0"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="名称" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Name" />
                                <Button Grid.Column="1" Content="驱动" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Driver" />
                                <Button Grid.Column="2" Content="作用域" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Scope" />
                            </Grid>

                            <ListView Grid.Row="2" Margin="12,0"
                                      ItemsSource="{x:Bind ViewModel.FilteredNetworks, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedNetwork, Mode=TwoWay}"
                                      SelectionMode="Single" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:NetworkInfo">
                                        <Grid Padding="8,6" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Driver}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Scope}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasNetworks), Mode=OneWay}">
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="暂无网络" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="创建一个网络，让多个容器通过名称互相访问。" FontSize="12.5"
                                               MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="没有匹配的网络" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="清除搜索" HorizontalAlignment="Center" Margin="0,12,0,0"
                                            Command="{x:Bind ViewModel.ClearSearchCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 卷页 -->
                        <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsVolumesPage), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="卷" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" PlaceholderText="搜索卷…" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Column="2" PlaceholderText="新卷名称" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.NewVolumeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="3" Content="新建卷" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.CreateVolumeCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanCreateVolume, Mode=OneWay}" />
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="排序 " /><Run Text="{x:Bind ViewModel.SortSummary, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Padding="8,6" Margin="12,0"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="名称" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Name" />
                                <Button Grid.Column="1" Content="驱动" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Driver" />
                                <Button Grid.Column="2" Content="挂载点" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Mountpoint" />
                            </Grid>

                            <ListView Grid.Row="2" Margin="12,0"
                                      ItemsSource="{x:Bind ViewModel.FilteredVolumes, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedVolume, Mode=TwoWay}"
                                      SelectionMode="Single" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:VolumeInfo">
                                        <Grid Padding="8,6" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Driver}" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Mountpoint}" FontSize="12" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasVolumes), Mode=OneWay}">
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="暂无数据卷" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="卷用于持久化容器数据，删除容器后依然保留。" FontSize="12.5"
                                               MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsSearching), Mode=OneWay}">
                                    <TextBlock Text="没有匹配的卷" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="清除搜索" HorizontalAlignment="Center" Margin="0,12,0,0"
                                            Command="{x:Bind ViewModel.ClearSearchCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 统计页 -->
                        <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsStatsPage), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="统计" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" PlaceholderText="搜索容器…" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Column="2" Text="wslc stats 为一次性快照，不会自动刷新。"
                                           FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button Grid.Column="3" Content="刷新快照" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.RefreshStatsCommand}" />
                            </Grid>

                            <Grid Grid.Row="1" Padding="12,0,12,8" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="运行中容器" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.RunningCountText, Mode=OneWay}"
                                                   FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="已停止 / 异常" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.StoppedCountText, Mode=OneWay}"
                                                   FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="快照容器数" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.StatsCountText, Mode=OneWay}"
                                                   FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="镜像 / 网络 / 卷" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ResourceSummaryText, Mode=OneWay}"
                                                   FontSize="22" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2" Padding="8,6" Margin="12,0"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="容器" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Container" />
                                <Button Grid.Column="1" Content="CPU%" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Cpu" />
                                <Button Grid.Column="2" Content="内存 / 限制" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Mem" />
                                <Button Grid.Column="3" Content="内存%" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="MemPercent" />
                                <Button Grid.Column="4" Content="网络 I/O" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="NetIo" />
                                <Button Grid.Column="5" Content="块 I/O" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="BlockIo" />
                                <Button Grid.Column="6" Content="PID" Style="{StaticResource HeaderButtonStyle}"
                                        Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="Pids" />
                            </Grid>

                            <ListView Grid.Row="3" Margin="12,0"
                                      ItemsSource="{x:Bind ViewModel.FilteredStats, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedStat, Mode=TwoWay}"
                                      SelectionMode="Single" Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="MinHeight" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:StatInfo">
                                        <Grid Padding="8,6" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Container}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Cpu}" FontSize="12" FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Mem}" FontSize="12" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind MemPercent}" FontSize="12" FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind NetIo}" FontSize="12" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind BlockIo}" FontSize="12" FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind Pids}" FontSize="12" FontFamily="Consolas"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel Grid.Row="3" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasStats), Mode=OneWay}">
                                <TextBlock Text="暂无资源统计" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="点击「刷新快照」采集一次当前用量。wslc 仅统计运行中的容器。"
                                           FontSize="12.5" MaxWidth="380" TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,6,0,12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Button Content="刷新快照" HorizontalAlignment="Center"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.RefreshStatsCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- 构建页 -->
                        <Grid Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsBuildPage), Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="构建" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" PlaceholderText="构建上下文目录 (含 Dockerfile)" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.BuildContext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="浏览" Command="{x:Bind ViewModel.PickBuildContextCommand}" />
                                <TextBox Grid.Column="3" PlaceholderText="标签 (如 myimage:latest)" VerticalAlignment="Center"
                                         Text="{x:Bind ViewModel.BuildTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="5" Content="开始构建" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.BuildImageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanBuild, Mode=OneWay}" />
                            </Grid>

                            <Border Grid.Row="1" Margin="12,8" CornerRadius="6"
                                    Background="{ThemeResource LogPaneBg}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <ScrollViewer Padding="12">
                                    <TextBlock Text="{x:Bind ViewModel.BuildOutput, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </ScrollViewer>
                            </Border>
                            <TextBlock Grid.Row="1" Text="构建日志将显示在此。填写上下文目录与标签后点击「开始构建」。"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.HasBuildOutput), Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </NavigationView.Content>
            </NavigationView>

            <!-- ============ 详情面板 ============ -->
            <Border Grid.Column="1" Width="340"
                    Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsDetailOpen), Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel>
                        <!-- 容器详情 -->
                        <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsContainersPage), Mode=OneWay}">
                            <StackPanel Padding="16,14" Spacing="10"
                                        Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.HasSelectedContainer), Mode=OneWay}">
                                <TextBlock Text="容器 · 详情" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedContainer.Name, Mode=OneWay}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border CornerRadius="9" Padding="8,2" BorderThickness="1"
                                            Background="{ThemeResource StatusRunningBg}" BorderBrush="{ThemeResource StatusRunningBd}"
                                            Visibility="{x:Bind ViewModel.SelectedContainer.IsRunning, Mode=OneWay}">
                                        <TextBlock Text="运行中" FontSize="11.5" Foreground="{ThemeResource StatusRunningFg}" />
                                    </Border>
                                    <Border CornerRadius="9" Padding="8,2" BorderThickness="1"
                                            Background="{ThemeResource StatusStoppedBg}" BorderBrush="{ThemeResource StatusStoppedBd}"
                                            Visibility="{x:Bind ViewModel.SelectedContainer.IsStopped, Mode=OneWay}">
                                        <TextBlock Text="已停止" FontSize="11.5" Foreground="{ThemeResource StatusStoppedFg}" />
                                    </Border>
                                    <Border CornerRadius="9" Padding="8,2" BorderThickness="1"
                                            Background="{ThemeResource StatusErrorBg}" BorderBrush="{ThemeResource StatusErrorBd}"
                                            Visibility="{x:Bind ViewModel.SelectedContainer.IsError, Mode=OneWay}">
                                        <TextBlock Text="异常退出" FontSize="11.5" Foreground="{ThemeResource StatusErrorFg}" />
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="运行信息" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="镜像" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind ViewModel.SelectedContainer.Image, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="端口" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind ViewModel.SelectedContainer.Ports, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="创建" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind ViewModel.SelectedContainer.CreatedAt, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="容器 ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedContainer.Id, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="状态原文" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedContainer.Status, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="资源占用" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Visibility="{x:Bind ViewModel.SelectedContainer.HasStats, Mode=OneWay}">
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CPU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedContainer.Cpu, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="内存" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedContainer.Mem, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="内存百分比" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedContainer.MemPercent, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="网络 I/O" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedContainer.NetIo, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedContainer.Pids, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock Text="未采集到资源快照。到「统计」页点一次「刷新快照」，这里会显示 CPU 与内存。"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.SelectedContainer.HasStats), Mode=OneWay}" />

                                <TextBlock Text="挂载" FontSize="11.5" FontWeight="SemiBold" Margin="0,12,0,6"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <!-- 读取中（默认） -->
                                <TextBlock Text="读取中…"
                                           FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind ViewModel.SelectedContainer.IsMountLoading, Mode=OneWay}" />
                                <!-- 已查无挂载 -->
                                <TextBlock Text="未挂载任何数据卷 / 目录。"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Visibility="{x:Bind ViewModel.SelectedContainer.IsMountEmpty, Mode=OneWay}" />
                                <!-- 有挂载：list 显示 src/rw → dest -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedContainer.Mounts, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.SelectedContainer.HasMounts, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ContainerMount">
                                            <Grid Style="{StaticResource KvRowStyle}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                           FontFamily="Consolas" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{x:Bind Display, Mode=OneTime}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Spacing="6" Margin="0,12,0,0">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="启动" HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.StartCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                        <Button Grid.Column="1" Content="停止" HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.StopCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="查看日志" HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.ShowLogsCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                        <Button Grid.Column="1" Content="打开终端" HorizontalAlignment="Stretch"
                                                Click="OpenTerminal_Click"
                                                IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}" />
                                    </Grid>
                                    <Button Content="删除容器" HorizontalAlignment="Stretch"
                                            Command="{x:Bind ViewModel.DeleteContainerCommand}"
                                            IsEnabled="{x:Bind ViewModel.CanActOnContainer, Mode=OneWay}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Padding="16,14" Spacing="8">
                                <TextBlock Text="未选择容器" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="在左侧列表中选择一个容器，这里会显示它的属性与可执行操作。双击列表行可直接打开终端。"
                                           FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 镜像详情 -->
                        <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsImagesPage), Mode=OneWay}">
                            <StackPanel Padding="16,14" Spacing="10"
                                        Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.HasSelectedImage), Mode=OneWay}">
                                <TextBlock Text="镜像 · 详情" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedImage.Reference, Mode=OneWay}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="仓库" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind ViewModel.SelectedImage.Repository, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="标签" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind ViewModel.SelectedImage.Tag, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="大小" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedImage.Size, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="摘要" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind ViewModel.SelectedImage.DigestDisplay, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="镜像 ID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedImage.Id, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <Button Content="删除镜像" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                        Command="{x:Bind ViewModel.DeleteImageCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanActOnImage, Mode=OneWay}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <StackPanel Padding="16,14" Spacing="8">
                                <TextBlock Text="未选择镜像" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="选中一个镜像后，这里显示标签、摘要与删除操作。"
                                           FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 网络详情 -->
                        <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsNetworksPage), Mode=OneWay}">
                            <StackPanel Padding="16,14" Spacing="10"
                                        Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.HasSelectedNetwork), Mode=OneWay}">
                                <TextBlock Text="网络 · 详情" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedNetwork.Name, Mode=OneWay}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="驱动" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind ViewModel.SelectedNetwork.Driver, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="作用域" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind ViewModel.SelectedNetwork.Scope, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <Button Content="删除网络" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                        Command="{x:Bind ViewModel.RemoveNetworkCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanActOnNetwork, Mode=OneWay}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <StackPanel Padding="16,14" Spacing="8">
                                <TextBlock Text="未选择网络" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="选中一个网络后，这里显示驱动、作用域与删除操作。"
                                           FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 卷详情 -->
                        <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsVolumesPage), Mode=OneWay}">
                            <StackPanel Padding="16,14" Spacing="10"
                                        Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.HasSelectedVolume), Mode=OneWay}">
                                <TextBlock Text="卷 · 详情" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedVolume.Name, Mode=OneWay}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="驱动" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind ViewModel.SelectedVolume.Driver, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="挂载点" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind ViewModel.SelectedVolume.Mountpoint, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <Button Content="删除卷" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                        Command="{x:Bind ViewModel.RemoveVolumeCommand}"
                                        IsEnabled="{x:Bind ViewModel.CanActOnVolume, Mode=OneWay}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <StackPanel Padding="16,14" Spacing="8">
                                <TextBlock Text="未选择卷" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="选中一个卷后，这里显示挂载点与删除操作。"
                                           FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 统计详情 -->
                        <StackPanel Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsStatsPage), Mode=OneWay}">
                            <StackPanel Padding="16,14" Spacing="10"
                                        Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.HasSelectedStat), Mode=OneWay}">
                                <TextBlock Text="资源快照 · 详情" FontSize="11.5"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedStat.Container, Mode=OneWay}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CPU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedStat.Cpu, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="内存 / 限制" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind ViewModel.SelectedStat.Mem, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="内存百分比" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedStat.MemPercent, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="网络 I/O" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind ViewModel.SelectedStat.NetIo, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="块 I/O" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Text="{x:Bind ViewModel.SelectedStat.BlockIo, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Style="{StaticResource KvRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PID" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="12"
                                                   Text="{x:Bind ViewModel.SelectedStat.Pids, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <Button Content="去容器页看该容器" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                        Command="{x:Bind ViewModel.NavigateCommand}" CommandParameter="Containers" />
                            </StackPanel>
                            <StackPanel Padding="16,14" Spacing="8">
                                <TextBlock Text="未选择容器" FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="选中一行快照后，这里显示该容器的完整资源占用。"
                                           FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 构建详情 -->
                        <StackPanel Padding="16,14" Spacing="10"
                                    Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsBuildPage), Mode=OneWay}">
                            <TextBlock Text="构建 · 说明" FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="从 Dockerfile 构建镜像" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="等价于 wslc build -t &lt;标签&gt; &lt;上下文&gt;。构建期间输出实时追加到左侧终端；再次点击「开始构建」会取消上一次未完成的构建。"
                                       FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="上下文目录必须包含 Dockerfile 或 Containerfile，否则直接报错，不会启动构建。"
                                       FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 日志抽屉（默认收起） ============ -->
        <Button Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Padding="14,8" Background="Transparent"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Command="{x:Bind ViewModel.ToggleLogPaneCommand}">
            <Button.KeyboardAccelerators>
                <KeyboardAccelerator Key="L" Modifiers="Control" />
            </Button.KeyboardAccelerators>
            <Grid>
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Run Text="日志" FontWeight="SemiBold" />
                    <Run Text="  " />
                    <Run Text="{x:Bind ViewModel.LogTarget, Mode=OneWay}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <FontIcon HorizontalAlignment="Right" Glyph="&#xE70E;" FontSize="11"
                          Visibility="{x:Bind conv:BoolConverters.InvertToVisibility(ViewModel.IsLogPaneOpen), Mode=OneWay}" />
                <FontIcon HorizontalAlignment="Right" Glyph="&#xE70D;" FontSize="11"
                          Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsLogPaneOpen), Mode=OneWay}" />
            </Grid>
        </Button>

        <Border Grid.Row="5" Height="230" Background="{ThemeResource LogPaneBg}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Visibility="{x:Bind conv:BoolConverters.ToVisibility(ViewModel.IsLogPaneOpen), Mode=OneWay}">
            <ScrollViewer Padding="12">
                <TextBlock Text="{x:Bind ViewModel.Logs, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
        </Border>

        <!-- ============ 状态栏 ============ -->
        <Grid Grid.Row="6" Padding="14,0" ColumnSpacing="14"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="11.5"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                <Run Text="{x:Bind ViewModel.StatusBarSummary, Mode=OneWay}" />
                <Run Text=" · wslc 2.9.9" />
            </TextBlock>
        </Grid>
    </Grid>
</Window>
