<Window
    x:Class="wslcUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wslcUI"
    xmlns:models="using:wslcUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="wslcUI — WSL 容器管理"
    Height="720" Width="1100">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Content="拉取 alpine" Command="{x:Bind ViewModel.PullCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Width="20" Height="20" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Containers -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                  BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                  BorderThickness="1">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="名称" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="镜像" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="状态" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ContainerInfo">
                    <Grid Padding="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Image}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="wslc 2.9.3 · Microsoft.WSL.Containers SDK (preview)" />
    </Grid>
</Window>
