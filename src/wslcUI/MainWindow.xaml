<Window
    x:Class="wslcUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:wslcUI"
    xmlns:models="using:wslcUI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="wslcUI — WSL 容器管理"
    Height="820" Width="1100">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
            <Button Content="启动" Command="{x:Bind ViewModel.StartCommand}" />
            <Button Content="停止" Command="{x:Bind ViewModel.StopCommand}" />
            <Button Content="删除容器" Command="{x:Bind ViewModel.DeleteContainerCommand}" />
            <Button Content="日志" Command="{x:Bind ViewModel.ShowLogsCommand}" />
            <Rectangle Width="1" Height="24" Fill="{ThemeResource ControlElevationBorderBrush}" />
            <TextBox Width="240" VerticalAlignment="Center"
                     PlaceholderText="镜像引用 (如 alpine:latest)"
                     Text="{x:Bind ViewModel.PullReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="拉取" Command="{x:Bind ViewModel.PullCommand}" />
            <Button Content="删除镜像" Command="{x:Bind ViewModel.DeleteImageCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                         Width="20" Height="20" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Body: containers (left) + images (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Containers -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="SemiBold"
                           Text="容器" Margin="0,0,0,8" />
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                          BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                          BorderThickness="1">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="名称" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="镜像" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="状态" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ContainerInfo">
                            <Grid Padding="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Image}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Images -->
            <Grid Grid.Column="1" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontWeight="SemiBold"
                           Text="镜像" Margin="0,0,0,8" />
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedImage, Mode=TwoWay}"
                          BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                          BorderThickness="1">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="仓库" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="标签" />
                                <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="大小" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImageInfo">
                            <Grid Padding="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Repository}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Tag}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Size}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Logs panel (always present; populated by the 日志 button) -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="日志" Margin="0,0,0,4" />
            <ScrollViewer Grid.Row="1"
                          BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                          BorderThickness="1">
                <TextBlock Text="{x:Bind ViewModel.Logs, Mode=OneWay}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas" Padding="8" />
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Margin="0,8,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="wslc 2.9.3 · Microsoft.WSL.Containers SDK (preview) + wslc CLI bridge for containers" />
    </Grid>
</Window>
